/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for most data,
 *              nesting user-specific data under the /users/{userId} path. Public or
 *              shared data is stored in separate top-level collections.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information. Only the user can read/write their profile.
 * - /users/{userId}/{subcollection}/{docId}: User-owned data. Only the user can read/write.
 *   Examples: transactions, goals, wallets, quests, simulatorPositions, moodEntries, nudgeLogs.
 * - /quests/{questTemplateId}: Public quest templates, readable by everyone.
 * - /badges/{badgeId}: Public badge definitions, readable by everyone.
 * - /leaderboards/{period}: Public leaderboard entries, readable by everyone.
 * - /community/{challengeId}: Public community challenges, readable by everyone.
 *
 * Key Security Decisions:
 * - User-owned data is strictly controlled via the /users/{userId} path.
 * - No user listing is allowed to prevent data leakage.
 * - Public collections are readable by everyone.
 * - All writes require authentication.
 *
 * Denormalization for Authorization:
 * - The 'userId' is embedded in documents within the `/users/{userId}` tree.
 *   This allows rules to quickly verify ownership without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, update, delete: if isOwner(userId);
      allow create: if request.auth.uid == userId;
      allow list: if false; // Prevent listing all users

      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      match /wallets/{walletId} {
        allow read, write: if isOwner(userId);
      }

      match /quests/{questId} {
        allow read, write: if isOwner(userId);
      }
      
      match /simulatorPositions/{simulatorPositionId} {
        allow read, write: if isOwner(userId);
      }

      match /moodEntries/{moodEntryId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /nudgeLogs/{userId} {
       allow read, write: if isOwner(userId);
    }
    
    match /quests/{questTemplateId} {
      allow get, list: if request.auth != null;
      allow write: if false;
    }

    match /badges/{badgeId} {
      allow get, list: if request.auth != null;
      allow write: if false;
    }

    match /leaderboards/{period} {
      allow get, list: if request.auth != null;
      allow write: if false;
    }

    match /community/{challengeId} {
      allow get, list: if request.auth != null;
      allow write: if false;
    }
  }
}
